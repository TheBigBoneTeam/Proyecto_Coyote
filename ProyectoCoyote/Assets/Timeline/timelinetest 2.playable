--- !u!114 &1527324515412665299
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Antes de que Coyote pudiera reacci\xF3nar, Lince levant\xF3 su arma
    y carg\xF3 contra \xE9l. Estaba claro que ese no era su hombre, y que hab\xEDa
    despertado una bestia que deb\xEDa ser derrotada."
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &3732158159767302112
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Cuando los abri\xF3 pudo ver el rostro de Lince solo durante unos
    segundos antes de que una mueca de dolor lo consumiera."
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &5303584863433541508
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Con las manos temblorosas, Coyote lanza las cenizas de Lince al interior
    de una de las grietas de la extra\xF1a piedra."
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &7811275962515439807
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Lo que alg\xFAn d\xEDa fue su amante mutaba en un monstruo sin expresi\xF3n
    y unos ojos vac\xEDos, controlado por unos cactus que ahora germinaba en su cuerpo."
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
