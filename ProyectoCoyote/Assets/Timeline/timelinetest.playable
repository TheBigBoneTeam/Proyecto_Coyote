  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Una extra\xF1a piedra surc\xF3 el cielo hasta Pricklytown, atraves\xF3
    el suelo e hizo surgir una planta que trae de vuelta a los muertos."
  leaveTime: 2
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
