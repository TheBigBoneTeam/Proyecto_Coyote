  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "A lo largo del desierto se habla de la leyenda de un hombre incapaz
    de superar la p\xE9rdida de su ser m\xE1s querido. Un hombre que sacrific\xF3
    todo lo que ten\xEDa y m\xE1s para verlo una \xFAltima vez. Un hombre que cruz\xF3
    las peligrosas tierras de priclytown para completar su objetivo.\n\nSu nombre
    era Coyote."
  leaveTime: 4
  startChars: 271
  startCharsList: 
  width: 1352.6
  personaje: 0
