  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Suena descabellado, \npero Coyote ha agotado ya las opciones razonables. "
  leaveTime: 1
  startChars: 19
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &-7431243313860136509
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
