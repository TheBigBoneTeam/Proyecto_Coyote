  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Abrasado por el sol, arrastra sus pies hasta la vera de un ca\xF1\xF3n.
    All\xED hab\xEDa un pueblo."
  leaveTime: 1
  startChars: 66
  startCharsList: 
  width: 1000
  personaje: 0
