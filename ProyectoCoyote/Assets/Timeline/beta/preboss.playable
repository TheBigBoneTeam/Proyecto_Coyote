  dialogText: "Cerr\xF3 los ojos."
  leaveTime: 0.3
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &-6287522031813351286
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Donde alg\xFAn d\xEDa hubo un manantial, ahora se yergue una roca
    extra\xF1a culminada por plantas que germinan de ella y la enredan."
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &-6219883652348433968
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Cerr\xF3 los ojos.\nNunca hab\xEDa rezado, y no sab\xEDa como hacerlo,
    pero rez\xF3."
  leaveTime: 1.5
  startChars: 15
  startCharsList: 
  width: 1000
  personaje: 0
