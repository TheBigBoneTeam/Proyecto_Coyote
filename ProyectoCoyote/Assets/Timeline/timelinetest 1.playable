--- !u!114 &2517462335388386335
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Coyote habl\xF3 de la leyenda, s\xED, pero sobre todo de su p\xE9rdida."
  leaveTime: 1.5
  startChars: 31
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &2626810466755692704
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "A cambio de un pedazo de su historia, \xE9l y su carreta estaban dispuestos
    a llevarles al ca\xF1\xF3n de Puertasdelcielo, cerca de donde ha lugar la leyenda
    del meteorito."
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &5050063821268331058
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "\"Lamento tu p\xE9rdida, forastero\"\n \u2500 El conductor cumpli\xF3
    su palabra y dej\xF3 a Coyote lo m\xE1s cerca posible del ca\xF1\xF3n."
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &5795525966298482581
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "\"Allende las rocas hay un oasis, pero all\xED ya no queda agua. Los
    cactus lo han consumido todo.\""
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
