  m_Name: DialogueClip(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "\"Bienvenido a Pricklytown\" \n \u2500 La voz de una tenebrosa dama
    lo saca de su trance:.\n\u2500\"No solemos recibir visitantes, no tan enteros.\""
  leaveTime: 1
  startChars: 80
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &-7579381161836731726
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
