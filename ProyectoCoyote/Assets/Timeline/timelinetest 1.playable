  m_EditorClassIdentifier: 
  dialogText: "Coyote habl\xF3 de la leyenda, s\xED,"
  leaveTime: 0.8
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &7136564252906215045
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Pero no todo ha sido en vano;\nen aquel extremo rec\xF3ndito de Pricklytown,
    hab\xEDa encontrado un hombre amable."
  leaveTime: 1.5
  startChars: 28
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &8318527776150509789
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Capturado y ajusticiado, Lince, el rifle vor\xE1z, hab\xEDa dejado
    solo a Coyote en este mundo seco y desagradable."
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &8762622116776507749
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Enga\xF1ado por la extra\xF1a dama, hab\xEDa limpiado el pueblo sin
    recibir nada a cambio."
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1000
  personaje: 0
--- !u!114 &9076897363962690569
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb417bb337dfa4595ebd46863bd161, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Lo que hoy es un hombre furioso fue alg\xFAn d\xEDa miembro de el
    d\xFAo de forajidos m\xE1s buscado del oeste."
  leaveTime: 1.5
  startChars: 0
  startCharsList: 
  width: 1060.8
  personaje: 0
